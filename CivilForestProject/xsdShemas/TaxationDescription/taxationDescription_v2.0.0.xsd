	<xs:element name="taxationDescription" type="tns:TaxationDescriptionType">
		<xs:annotation>
			<xs:documentation>Таксационное описание лесотаксационного выдела</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:complexType name="TaxationDescriptionType">
		<xs:annotation>
			<xs:documentation>Таксационное описание лесотаксационного выдела</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="header" type="tns:HeaderType">
				<xs:annotation>
					<xs:documentation>Общие сведения</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="initialData" type="tns:InitialDataType">
				<xs:annotation>
					<xs:documentation>Исходные данные</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="characteristicsInfo" type="tns:ForestQuartersType">
				<xs:annotation>
					<xs:documentation>Сведения о характеристиках лесотаксационных выделов</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="explanatoryNote" type="st:String4000SType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Пояснительная записка</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ForestQuartersType">
		<xs:annotation>
			<xs:documentation>Сведения о характеристиках</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="forestQuarter" type="tns:ForestQuarterType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Информация о лесном квартале</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ForestQuarterType">
		<xs:annotation>
			<xs:documentation>Сведения о лесном квартале</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="characteristicsForestQuarter"
				type="tns:CharacteristicsForestQuarterType">
				<xs:annotation>
					<xs:documentation>Характеристики лесного квартала</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="containForestQuarter" type="tns:ContainForestQuarterType"
				minOccurs="1">
				<xs:annotation>
					<xs:documentation>Информация о содержимом лесного квартала</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CharacteristicsForestQuarterType">
		<xs:annotation>
			<xs:documentation>Характеристики лесного квартала</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="forestryName" type="tns:ForestryType">
				<xs:annotation>
					<xs:documentation>Лесничество</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="steadForestryName" type="tns:SteadForestryType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Участковое лесничество</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="nameTract" type="st:String128SType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Наименование урочища, лесной дачи, номер технического участка, иные сведения о подразделении до 01.01.2023 лесничеств, участковых лесничеств на составные части (при наличии)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="fgislkForestQuarterNumber" type="st:String25SType">
				<xs:annotation>
					<xs:documentation>Учетный номер ФГИС ЛК лесного квартала</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="luForestQuarterNumber" type="st:String25SType">
				<xs:annotation>
					<xs:documentation>Лесоустроительный номер лесного квартала</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="taxationCategory" type="taxcat:TaxationCategoryKindEType"
				minOccurs="0">
				<xs:annotation>
					<xs:documentation>Лесотаксационный разряд</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ContainForestQuarterType">
		<xs:annotation>
			<xs:documentation>Информация о содержимом лесного квартала</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="taxationPiece" type="tns:TaxationPieceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Информация о выделе</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TaxationPieceType">
		<xs:annotation>
			<xs:documentation>Сведения о лесотаксационном выделе</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="characteristicsTaxationPiece"
				type="tns:CharacteristicsTaxationPieceType">
				<xs:annotation>
					<xs:documentation>Характеристики лесотаксационного выдела</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CharacteristicsTaxationPieceType">
		<xs:annotation>
			<xs:documentation>Характеристики лесотаксационного выдела</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="relations" type="tns:RelationsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Связи выдела с ОЗУЛ, КЗЛ, ВЛЦН</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="contoursLocation" type="contour:PopdContoursLocationType">
				<xs:annotation>
					<xs:documentation>Описание границ лесотаксационного выдела</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="currentAndPreviousNumbers" type="tns:CurrentAndPreviousNumbersType">
				<xs:annotation>
					<xs:documentation>Ранее присвоенные номера лесотаксационного выдела</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dateEndTaxationPiece" type="xs:date" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дата прекращения существования лесотаксационного выдела, в случае прекращения его существования</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="documentationDate" type="st:DateSType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дата подготовки лесоустроительной документации</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="area" type="sfre:AreaType">
				<xs:annotation>
					<xs:documentation>Площадь</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="calcError" type="xs:decimal" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Погрешность вычисления</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="categoryLand" type="catforest:CategoryLandForestryKindEType">
				<xs:annotation>
					<xs:documentation>Категория земель</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="totalStockForest" type="tns:TotalStockForestType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Общий запас лесных насаждений (при наличии)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="registrationNumberCuttingArea" type="st:String50SType" minOccurs="0"
				maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Учетный номер лесосеки, расположенной в границе лесотаксационного выдела</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="typeLand" type="catland:CategoryLandKindEType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Тип земель (лесные/нелесные)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="typeForestLand" type="landt:LandTypeKindEType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Вид лесных земель</xs:documentation>
				</xs:annotation>
			</xs:element>
